---
import DrawerPrimitive from "@starwind-ui/astro/drawer";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & {
  defaultOpen?: boolean;
  closeOnEscape?: boolean;
  closeOnOutsideInteract?: boolean;
  /** Off by default: this drawer is meant to sit inside its own preview, not block the whole page. */
  modal?: boolean;
};

const {
  defaultOpen = false,
  closeOnEscape = true,
  closeOnOutsideInteract = true,
  modal = false,
  class: className,
  ...rest
} = Astro.props;
---

<DrawerPrimitive.Root
  class={className}
  defaultOpen={defaultOpen}
  closeOnEscape={closeOnEscape}
  closeOnOutsideInteract={closeOnOutsideInteract}
  modal={modal}
  {...rest}
  data-slot="drawer"
>
  <slot />
</DrawerPrimitive.Root>
