---
import DSLogo from "@/components/DSLogo2.svg";
import Button from "../starwind/button/Button.astro";
import PathMarqueeDemo from "./vue/PathMarqueeDemo.vue";
---

 <section class="w-full mt-10 mb-20 px-4">
    <div class="mx-auto flex w-full max-w-3xl min-w-0 flex-col items-center gap-4">
        <DSLogo class="w-40 text-neutral-600 dark:text-neutral-50" />
        <h1 class="mt-8 text-4xl lg:text-5xl font-bold font-serif text-neutral-900 dark:text-neutral-50 text-center">Library of reusable components</h1>
        <p class="text-neutral-700 dark:text-neutral-300">v6v7</p>
        <div class="flex flex-wrap justify-center gap-4 mt-8">
            <Button
                variant="primary"
                size="md"
                class="text-neutral-800"
                href="/admin"
                >Create Components
            </Button>
            <Button
                variant="secondary"
                size="md"
                class="text-neutral-800 dark:text-neutral-50"
                href="/login"
                >Explore Components</Button>
        </div>
    </div>

    <PathMarqueeDemo client:only="vue" />
</section>