---
import DSLogo from "@/components/DSLogo2.svg";
import Button from "../starwind/button/Button.astro";
import PathMarqueeDemo from "./vue/PathMarqueeDemo.vue";
---

 <section class="w-full grid place-items-center my-40">
    <div class="flex flex-col items-center gap-4  ">
        <DSLogo class="w-40 text-neutral-600 dark:text-neutral-50" />
        <h1 class="mt-8 text-4xl lg:text-5xl font-bold font-serif text-neutral-900 dark:text-neutral-50">Library of reusable components</h1>
        <p class="text-neutral-700 dark:text-neutral-300">v6v7</p>
        <div class="flex gap-4 mt-8">
            <Button
                variant="primary"
                size="md"
                class="text-neutral-800"
                href="/admin"
                >Create Components
            </Button>
            <Button
                variant="secondary"
                size="md"
                class="text-neutral-800"
                href="/login"
                >Explore Components</Button>
        </div>

        <PathMarqueeDemo client:load />
    </div>
</section>