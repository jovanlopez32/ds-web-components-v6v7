---
/**
 * Renders one stored component — live example plus its source — anywhere.
 *
 * This is the escape hatch from the database-driven navigation: the pages and
 * subpages in /admin are the site's main structure, but a developer can also
 * hand-write an Astro page and pull in whatever components it needs:
 *
 *   ---
 *   import CodeComponent from '../components/CodeComponent.astro';
 *   ---
 *   <CodeComponent id="1" />
 *
 * `id` is the component's short `ref` number, shown in the editor. It is a
 * separate sequential column precisely so this tag stays writable by hand; the
 * uuid primary key would not be.
 *
 * Everything here still runs on the server — the source listings are
 * highlighted by Astro's built-in <Code /> (Shiki) and shipped as plain,
 * pre-rendered markup. The only client script is the one that wires up the
 * resize rail and the source drawer, and it is shared by every instance on
 * the page (Astro dedupes identical <script> blocks).
 */
import { Code } from 'astro:components';
import IconDeviceDesktop from '@tabler/icons/outline/device-desktop.svg';
import IconDeviceTablet from '@tabler/icons/outline/device-tablet.svg';
import IconDeviceMobile from '@tabler/icons/outline/device-mobile.svg';
import IconGripVertical from '@tabler/icons/outline/grip-vertical.svg';
import IconCopy from '@tabler/icons/outline/copy.svg';
import IconCheck from '@tabler/icons/outline/check.svg';
import IconX from '@tabler/icons/outline/x.svg';
import Drawer from './starwind/drawer';
import Skeleton from './starwind/skeleton';
import { supabase } from '../lib/supabase';
import { loadPreviewSettingsCached, loadGlobalVariables } from '../lib/settings';
import { buildPreviewDocument, PREVIEW_SANDBOX } from '../lib/preview';
import { compileComponentLess } from '../lib/less-server';
import { mergeVariables, resolveAsp } from '../lib/asp';

interface Props {
	/** The component's `ref` number. Accepts a string so id="1" reads naturally. */
	id: string | number;
	/** Set false to show only the live example, without the source drawer. */
	showCode?: boolean;
	/** Height of the preview frame. Components vary wildly, so it is a prop. */
	height?: string;
}

const { id, showCode = true, height = '520px' } = Astro.props;

// The anon client: components are public-read, and these pages are public.
const { data: component } = await supabase
	.from('components')
	.select('ref, title, asp_code, less_code, js_code, mixins_code, variables, created_by_email, updated_at')
	.eq('ref', Number(id))
	.maybeSingle();

// A missing ref is a developer typo in hand-written markup, so it needs to be
// visible on the page rather than silently rendering nothing.
const [settings, globalVariables] = component
	? await Promise.all([loadPreviewSettingsCached(supabase), loadGlobalVariables(supabase)])
	: [null, null];

const compiled = component
	? await compileComponentLess(
			component.less_code ?? '',
			settings!.previewLessVariables,
			component.mixins_code ?? '',
		)
	: null;

const resolved = component
	? resolveAsp(
			component.asp_code ?? '',
			mergeVariables(globalVariables!, component.variables ?? {}),
		)
	: null;

const srcDoc =
	component && compiled && resolved
		? buildPreviewDocument(
				{ markup: resolved.code, css: compiled.css, jsCode: component.js_code ?? '' },
				settings!,
			)
		: '';

/** Only the languages this component actually uses get a button + panel. */
const listings = component
	? (
			[
				{ lang: 'asp' as const, label: 'ASP', shiki: 'html' as const, code: component.asp_code },
				{ lang: 'less' as const, label: 'LESS', shiki: 'less' as const, code: component.less_code },
				{ lang: 'mixins' as const, label: 'Mixins', shiki: 'less' as const, code: component.mixins_code },
				{ lang: 'js' as const, label: 'JS', shiki: 'js' as const, code: component.js_code },
			] as const
		).filter((listing) => listing.code && listing.code.trim())
	: [];

const showDrawer = showCode && listings.length > 0;

// DOM-unique per render, since a page can embed several components.
const uid = `cc-${component?.ref ?? 'missing'}-${Math.random().toString(36).slice(2, 8)}`;
const frameId = `${uid}-frame`;

/** Bootstrap's own breakpoints — the resize presets snap to these exactly. */
const PRESETS = [
	{ label: 'Mobile', width: 576, Icon: IconDeviceMobile },
	{ label: 'Tablet', width: 768, Icon: IconDeviceTablet },
	{ label: 'Desktop', width: 1200, Icon: IconDeviceDesktop },
];
---

{
	!component ? (
		<p class="bg-error/10 px-4 py-3 text-sm text-error">
			No component exists with <code>id="{id}"</code>. The number is the
			<strong> Reference</strong> field shown by the editor.
		</p>
	) : (
		<section class="my-8 bg-muted/40 p-4 sm:p-5" data-cc>
			<header class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
				<h2 class="text-lg font-semibold text-foreground">{component.title}</h2>
				<p class="text-xs text-muted-foreground">
					Ref <code class="bg-muted px-1.5 py-0.5">{component.ref}</code>
					{component.created_by_email && <> · {component.created_by_email}</>}
					{' · '}
					{new Date(component.updated_at).toLocaleDateString('en-US', { dateStyle: 'medium' })}
				</p>
			</header>

			{compiled?.error && (
				<p class="mb-4 bg-error/10 px-4 py-3 text-sm text-error" role="alert">
					This component's LESS does not compile: {compiled.error.message}
				</p>
			)}

			<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
				<div class="flex flex-wrap items-center gap-3">
					<span
						class="inline-flex items-center gap-1.5 bg-muted px-2.5 py-1 text-xs font-medium tabular-nums text-muted-foreground"
						data-cc-readout
					>
						100% · xxl
					</span>

					<div class="inline-flex items-center gap-1 bg-muted p-1">
						{PRESETS.map(({ label, width, Icon }) => (
							<button
								type="button"
								class="appearance-none p-1.5 text-muted-foreground outline-none transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary data-[active=true]:bg-foreground data-[active=true]:text-background"
								data-cc-preset={width}
								aria-label={`${label} view (${width}px)`}
								title={`${label} · ${width}px`}
							>
								<Icon class="size-4" aria-hidden="true" />
							</button>
						))}
					</div>
				</div>

				{showDrawer && (
					<div class="inline-flex items-center gap-1 bg-muted p-1" data-cc-langs>
						{listings.map((listing) => (
							<button
								type="button"
								class="appearance-none px-2.5 py-1 text-xs font-medium text-muted-foreground outline-none transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary data-[active=true]:bg-foreground data-[active=true]:text-background"
								data-cc-lang-btn
								data-lang={listing.lang}
							>
								{listing.label}
							</button>
						))}
					</div>
				)}
			</div>

			<div class="-mx-4 flex items-stretch justify-center gap-2 sm:mx-0" data-cc-stage>
				<div
					class="relative overflow-hidden bg-background"
					id={frameId}
					style={`width: 100%; height: ${height};`}
					data-cc-frame
				>
					<!--
						Same sandbox as the editor's preview: `allow-scripts` without
						`allow-same-origin`, so the component's JS runs but cannot reach
						this page's DOM or cookies.
					-->
					<!--
						No `srcdoc` here on purpose: the moment the browser parses that
						attribute it creates the nested document and starts fetching
						everything the preview references (jQuery/Bootstrap from a CDN,
						etc.), whether or not this block is on screen. A page can stack many
						of these, so the actual markup sits inert in the <template> below
						and the script at the bottom assigns it to the iframe only once the
						block scrolls near the viewport.
					-->
					<iframe
						title={`Example of ${component.title}`}
						class="block w-full"
						style={`height: ${height}`}
						sandbox={PREVIEW_SANDBOX}
						data-cc-iframe
					/>
					<template data-cc-srcdoc set:html={srcDoc} />

					<!--
						Under the drawer's z-index (z-30 vs z-50) so the source can still be
						opened while the example loads, and over the frame's own background
						so the iframe's blank white body never shows through. The shapes are
						deliberately generic: a stored component can be anything from a single
						button to a full carousel, so there is nothing worth guessing at.
					-->
					<div
						class="pointer-events-none absolute inset-0 z-30 flex flex-col gap-4 bg-background p-6"
						data-cc-skeleton
						aria-hidden="true"
					>
						<Skeleton class="h-7 w-2/5 rounded-none" />
						<div class="flex flex-col gap-2">
							<Skeleton class="h-3.5 w-full rounded-none" />
							<Skeleton class="h-3.5 w-11/12 rounded-none" />
							<Skeleton class="h-3.5 w-3/4 rounded-none" />
						</div>
						<Skeleton class="min-h-0 flex-1 rounded-none" />
						<div class="flex gap-2">
							<Skeleton class="h-9 w-28 rounded-none" />
							<Skeleton class="h-9 w-20 rounded-none" />
						</div>
					</div>

					{showDrawer && (
						<Drawer.Root data-cc-drawer closeOnOutsideInteract={false} closeOnEscape={false} modal={false}>
							<!--
								Fills the whole frame (`max-w-none` overrides the primitive's
								420px side-panel default): the language tabs live in the
								toolbar above now, not floating on the preview, so there is no
								reason left to keep a sliver of the live preview visible
								behind the code. It is either the preview or the source.
							-->
							<Drawer.Content
								container={`#${frameId}`}
								side="right"
								class="max-w-none bg-neutral-900 text-neutral-50"
							>
								<div class="flex items-center justify-between gap-2 px-4 py-3">
									<Drawer.Title data-cc-sheet-title class="text-sm font-semibold">
										{listings[0].label}
									</Drawer.Title>
									<div class="flex items-center gap-1">
										<button
											type="button"
											class="appearance-none inline-flex items-center gap-1.5 px-2 py-1.5 text-neutral-50/70 outline-none transition-colors hover:bg-neutral-50/15 hover:text-neutral-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-50"
											data-cc-copy
											title="Copy code"
											aria-label="Copy code"
										>
											<IconCopy class="size-3.5" data-cc-copy-icon aria-hidden="true" />
											<IconCheck class="hidden size-3.5" data-cc-copy-check aria-hidden="true" />
										</button>
										<button
											type="button"
											class="appearance-none inline-flex size-7 shrink-0 items-center justify-center text-neutral-50/70 outline-none transition-colors hover:bg-neutral-50/15 hover:text-neutral-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-50"
											data-cc-close
											title="Close"
											aria-label="Close code view"
										>
											<IconX class="size-4" aria-hidden="true" />
										</button>
									</div>
								</div>
								<div class="min-h-0 flex-1 overflow-auto">
									{listings.map((listing, index) => (
										<div data-cc-panel data-lang={listing.lang} data-code={listing.code} hidden={index !== 0}>
											<Code code={listing.code!} lang={listing.shiki} theme="github-dark" />
										</div>
									))}
								</div>
							</Drawer.Content>
						</Drawer.Root>
					)}
				</div>

				<div
					class="hidden w-6 shrink-0 cursor-col-resize items-center justify-center bg-muted text-muted-foreground transition-colors hover:bg-primary/15 hover:text-primary active:bg-primary/20 sm:flex"
					data-cc-handle
					title="Drag to change the preview width"
					aria-label="Resize the preview"
					role="separator"
					aria-orientation="vertical"
				>
					<IconGripVertical class="size-4" aria-hidden="true" />
				</div>
			</div>
		</section>
	)
}

<style>
	/*
	 * 320px of minimum width plus the 24px resize rail and its gap needs 352px,
	 * which a 390px phone does not have once the card's own padding is taken
	 * out — the frame used to spill past the card and lose its left edge. The
	 * rail is a pointer-drag affordance with no touch equivalent, so below sm
	 * it is hidden and the frame stops reserving room for it. The preset
	 * buttons stay, and they are the control that works under a thumb.
	 */
	[data-cc-frame] {
		min-width: 0;
		max-width: 100%;
	}

	@media (min-width: 40rem) {
		[data-cc-frame] {
			min-width: 320px;
			max-width: calc(100% - 2rem);
		}
	}

	[data-cc-panel] :global(pre) {
		margin: 0;
		padding: 1rem;
		font-size: 0.8125rem;
		background: transparent !important;
	}

	/*
	 * A closed <dialog> is display:none by the UA stylesheet, but the popup
	 * carries its own `flex`, which outranks it — so the source panel is on
	 * screen from first paint until the starwind runtime loads and hides it.
	 * On a slow connection that is a full code listing sitting over the
	 * example, and over the skeleton below. Keep it out until the script at
	 * the bottom of this file has run and claimed the component.
	 */
	[data-cc]:not([data-cc-ready]) :global([data-sw-drawer-popup]) {
		display: none;
	}

	/*
	 * The example loads its own remote assets — icon fonts, jQuery — from
	 * the platform's CDN, so there is a real gap between this page painting
	 * and the component being visible. Driven by an attribute on the iframe
	 * rather than from the script below so the handoff survives the script
	 * not having run yet.
	 */
	[data-cc-skeleton] {
		transition: opacity 350ms ease;
	}

	[data-cc-iframe][data-loaded] ~ [data-cc-skeleton] {
		opacity: 0;
		/* Held back until the fade ends, so `animate-pulse` stops repainting
		   once the placeholder is gone without popping it out mid-transition. */
		visibility: hidden;
		transition:
			opacity 350ms ease,
			visibility 0s linear 350ms;
	}

	@media (prefers-reduced-motion: reduce) {
		/* Both selectors, and in this order: the rule above is more specific
		   than a bare [data-cc-skeleton], and a media query does not outrank
		   specificity. */
		[data-cc-skeleton],
		[data-cc-iframe][data-loaded] ~ [data-cc-skeleton] {
			transition: none;
		}

		[data-cc-skeleton] :global([data-sw-skeleton]) {
			animation: none;
		}
	}
</style>

<script>
	import { createDrawer } from '@starwind-ui/runtime/drawer';
	import { gsap } from 'gsap';

	const MIN_WIDTH = 320;
	const COPY_FEEDBACK_MS = 1500;
	const SKELETON_MAX_WAIT_MS = 8000;
	// Starts loading a bit before the block is actually on screen, so a preview
	// that takes a moment to fetch its remote assets is already underway by the
	// time it scrolls fully into view instead of showing the skeleton longer.
	const PREVIEW_ROOT_MARGIN = '400px 0px';

	// Open and close are deliberate mirrors — the same curve read backwards —
	// so the sheet leaves the way it arrived. `power3` also distributes the
	// travel far more evenly than `expo`, which covers roughly three quarters
	// of the distance in the first fifth of the tween and so reads as a jump
	// followed by a crawl rather than as one movement.
	const OPEN_DURATION = 0.55;
	const OPEN_EASE = 'power3.out';
	const CLOSE_DURATION = 0.45;
	const CLOSE_EASE = 'power3.in';

	// Width is a layout property: every frame re-lays out the preview iframe's
	// entire document, so the resize gets a longer, gentler curve than the
	// sheet — it has more work to do per frame and less distance to hide it in.
	const RESIZE_DURATION = 0.7;
	const RESIZE_EASE = 'power3.inOut';

	const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	/**
	 * Runs `callback` once the element is actually rendered, plus one more frame.
	 *
	 * `drawer.open()` normally un-hides the <dialog> synchronously, but the
	 * portal it lives in can defer the reveal by a frame or two, and the first
	 * reveal is also the first time the browser lays out and paints the
	 * syntax-highlighted source — an expensive frame. GSAP's clock is wall
	 * time, so starting the slide before that frame lands means the first
	 * rendered frame is already a third of the way through the tween, which is
	 * exactly what makes the entrance look clipped. Waiting costs a couple of
	 * frames with the sheet parked off-canvas (invisible) and buys the tween a
	 * full set of frames on a warm layer.
	 */
	function whenRendered(element: HTMLElement, callback: () => void, tries = 12) {
		const rendered = element.isConnected && !element.hidden && element.getClientRects().length > 0;
		if (rendered || tries <= 0) {
			requestAnimationFrame(callback);
			return;
		}
		requestAnimationFrame(() => whenRendered(element, callback, tries - 1));
	}

	function bucketFor(width: number): string {
		if (width < 576) return 'xs';
		if (width < 768) return 'sm';
		if (width < 992) return 'md';
		if (width < 1200) return 'lg';
		if (width < 1400) return 'xl';
		return 'xxl';
	}

	function setup(root: HTMLElement) {
		root.setAttribute('data-cc-ready', '');

		const frame = root.querySelector<HTMLElement>('[data-cc-frame]');
		const handle = root.querySelector<HTMLElement>('[data-cc-handle]');
		const readout = root.querySelector<HTMLElement>('[data-cc-readout]');
		const presetButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-cc-preset]'));

		// Which preset the last click asked for, or null once the width stopped
		// being a preset's doing (a drag). Tracked rather than inferred from the
		// measured width because `max-width: calc(100% - 2rem)` can clamp the
		// result — on a narrow viewport the Desktop preset never reaches 1200px,
		// and the button it came from should still read as the active one.
		let presetTarget: number | null = null;

		function clearPresetActive() {
			presetButtons.forEach((button) => button.removeAttribute('data-active'));
		}

		function syncFromWidth(width: number) {
			if (readout) readout.textContent = `${Math.round(width)}px · ${bucketFor(width)}`;
			clearPresetActive();
			const active = presetTarget ?? Math.round(width);
			for (const button of presetButtons) {
				if (active === Number(button.dataset.ccPreset)) {
					button.setAttribute('data-active', 'true');
					break;
				}
			}
		}

		/** The widest the frame can actually render, per its own `max-width`. */
		function maxWidthOf(element: HTMLElement) {
			const max = Number.parseFloat(getComputedStyle(element).maxWidth);
			return Number.isFinite(max) ? max : Number.POSITIVE_INFINITY;
		}

		// Clamped before the tween starts, not left to CSS: an unclamped target
		// would keep the tween running after the visible width had already
		// stopped moving, so the resize would feel like it ended early.
		function resizeTo(element: HTMLElement, width: number) {
			const target = Math.min(Math.max(width, MIN_WIDTH), maxWidthOf(element));
			if (reduceMotion()) {
				gsap.set(element, { width: target });
				return;
			}
			gsap.to(element, {
				width: target,
				duration: RESIZE_DURATION,
				ease: RESIZE_EASE,
				overwrite: true,
			});
		}

		if (frame) {
			new ResizeObserver((entries) => syncFromWidth(entries[0].contentRect.width)).observe(frame);
		}

		presetButtons.forEach((button) => {
			button.addEventListener('click', () => {
				if (!frame) return;
				presetTarget = Number(button.dataset.ccPreset);
				// Light the button now instead of waiting for the tween to arrive.
				syncFromWidth(frame.getBoundingClientRect().width);
				resizeTo(frame, presetTarget);
			});
		});

		if (handle && frame) {
			let dragging = false;
			let startX = 0;
			let startWidth = 0;
			let pendingWidth: number | null = null;
			let pendingFrame = 0;

			function flushDragWidth() {
				pendingFrame = 0;
				if (pendingWidth === null || !frame) return;
				frame.style.width = `${pendingWidth}px`;
				pendingWidth = null;
			}

			handle.addEventListener('pointerdown', (event) => {
				dragging = true;
				startX = event.clientX;
				startWidth = frame.getBoundingClientRect().width;
				// The hand wins over any preset still animating, and the button it
				// came from stops claiming to describe the current width.
				gsap.killTweensOf(frame);
				presetTarget = null;
				handle.setPointerCapture(event.pointerId);
			});

			handle.addEventListener('pointermove', (event) => {
				if (!dragging) return;
				// `max-width: calc(100% - 2rem)` on the frame leaves room for this
				// rail and clamps the visual result, so the only floor that matters
				// here is the minimum width we're willing to render at.
				pendingWidth = Math.max(MIN_WIDTH, startWidth + (event.clientX - startX));
				// Pointer events can fire several times per frame and each width
				// write re-lays out the preview iframe's document, so coalesce to
				// one write per frame and let the newest position win.
				if (!pendingFrame) pendingFrame = requestAnimationFrame(flushDragWidth);
			});

			const stopDrag = (event: PointerEvent) => {
				if (!dragging) return;
				dragging = false;
				if (pendingFrame) {
					cancelAnimationFrame(pendingFrame);
					flushDragWidth();
				}
				if (handle.hasPointerCapture(event.pointerId)) handle.releasePointerCapture(event.pointerId);
			};
			handle.addEventListener('pointerup', stopDrag);
			handle.addEventListener('pointercancel', stopDrag);
		}

		const drawerRoot = root.querySelector<HTMLElement>('[data-cc-drawer]');
		const popup = root.querySelector<HTMLElement>('[data-sw-drawer-popup]');
		const closeButton = root.querySelector<HTMLButtonElement>('[data-cc-close]');
		const langButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-cc-lang-btn]'));
		const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-cc-panel]'));
		const sheetTitle = root.querySelector<HTMLElement>('[data-cc-sheet-title]');
		const copyButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-cc-copy]'));
		if (!drawerRoot || langButtons.length === 0) return;

		const drawer = createDrawer(drawerRoot);
		let activeLang = panels[0]?.dataset.lang ?? null;
		let closing = false;

		// Tabs only read as "active" while the sheet showing them is actually
		// open — a tab is a trigger here, not a permanent selection, so it must
		// not look pressed while there is nothing visible behind it.
		function syncActiveTabs() {
			const open = drawer.getOpen();
			langButtons.forEach((button) => {
				button.setAttribute('data-active', open && button.dataset.lang === activeLang ? 'true' : 'false');
			});
		}

		function showPanel(lang: string) {
			activeLang = lang;
			panels.forEach((panel) => {
				panel.hidden = panel.dataset.lang !== lang;
			});
			syncActiveTabs();
			const activeButton = langButtons.find((button) => button.dataset.lang === lang);
			if (sheetTitle && activeButton) sheetTitle.textContent = activeButton.textContent?.trim() ?? '';
		}

		if (activeLang) showPanel(activeLang);

		// The sheet slides in/out on its own transform, independently of the
		// runtime's open/closed bookkeeping: `drawer.open()` reveals the
		// <dialog> (already positioned off-canvas, set synchronously first so
		// there's nothing to flash), then GSAP animates it to rest. Closing
		// runs the mirrored slide-out first and only calls `drawer.close()`
		// (which hides the <dialog>) once that finishes, so the exit is never
		// cut short by the instant native hide.
		let closeTween: gsap.core.Tween | null = null;

		function slideIn() {
			if (!popup || !drawer.getOpen() || closing) return;
			gsap.to(popup, {
				xPercent: 0,
				duration: OPEN_DURATION,
				ease: OPEN_EASE,
				overwrite: 'auto',
				force3D: true,
				onComplete: () => gsap.set(popup, { willChange: 'auto' }),
			});
		}

		function animatedOpen() {
			if (!popup) return;

			// Interrupting a close: the sheet is still on screen, so pick the
			// slide back up from wherever it got to rather than snapping it
			// off-canvas and starting over.
			if (closing) {
				closeTween?.kill();
				closeTween = null;
				closing = false;
				slideIn();
				return;
			}
			if (drawer.getOpen()) return;

			if (reduceMotion()) {
				gsap.set(popup, { xPercent: 0 });
				drawer.open();
				return;
			}

			// `will-change` before the reveal, so the compositor has the layer
			// ready by the time the tween's first frame runs; dropped again on
			// completion rather than left on, since a permanent layer costs
			// memory and softens the code's text rendering.
			gsap.set(popup, { xPercent: 100, willChange: 'transform', force3D: true });

			// `drawer.open()` focuses the first control inside the sheet, and at
			// that moment the sheet is still parked off-canvas — so the browser
			// scrolls to "reveal" it, shoving the frame's content and the page
			// sideways. Put both back before anything is painted.
			const pageX = window.scrollX;
			const pageY = window.scrollY;
			drawer.open();
			frame?.scrollTo(0, 0);
			window.scrollTo(pageX, pageY);

			whenRendered(popup, slideIn);
		}

		function animatedClose() {
			if (!popup || !drawer.getOpen() || closing) return;
			if (reduceMotion()) {
				drawer.close();
				return;
			}
			closing = true;
			gsap.set(popup, { willChange: 'transform' });
			closeTween = gsap.to(popup, {
				xPercent: 100,
				duration: CLOSE_DURATION,
				ease: CLOSE_EASE,
				overwrite: 'auto',
				force3D: true,
				onComplete: () => {
					closing = false;
					closeTween = null;
					gsap.set(popup, { willChange: 'auto' });
					drawer.close();
				},
			});
		}

		langButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const lang = button.dataset.lang;
				if (!lang) return;
				// Mid-close the sheet is still `getOpen()`, but it is on its way
				// out — so a click there means "come back", not "close again".
				const visible = drawer.getOpen() && !closing;
				if (visible && activeLang === lang) {
					animatedClose();
					return;
				}
				showPanel(lang);
				animatedOpen();
			});
		});

		closeButton?.addEventListener('click', animatedClose);

		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape' || !drawer.getOpen()) return;
			event.preventDefault();
			animatedClose();
		});

		drawer.subscribe('openChange', syncActiveTabs);

		copyButtons.forEach((button) => {
			const icon = button.querySelector<HTMLElement>('[data-cc-copy-icon]');
			const check = button.querySelector<HTMLElement>('[data-cc-copy-check]');
			let resetTimer: ReturnType<typeof setTimeout> | null = null;

			button.addEventListener('click', async () => {
				const panel = panels.find((p) => p.dataset.lang === activeLang);
				const code = panel?.dataset.code;
				if (!code) return;

				await navigator.clipboard.writeText(code);

				icon?.classList.add('hidden');
				check?.classList.remove('hidden');
				if (resetTimer) clearTimeout(resetTimer);
				resetTimer = setTimeout(() => {
					icon?.classList.remove('hidden');
					check?.classList.add('hidden');
				}, COPY_FEEDBACK_MS);
			});
		});
	}

	/**
	 * Moves the inert `<template>`'s markup onto the iframe and arms the same
	 * "clear the skeleton" plumbing the eager `onload` attribute used to
	 * provide: a `load` listener, plus a failsafe in case a stalled remote
	 * asset in the preview holds `load` back indefinitely.
	 */
	function activatePreview(iframe: HTMLIFrameElement) {
		const template = iframe.nextElementSibling;
		if (!(template instanceof HTMLTemplateElement)) return;
		iframe.srcdoc = template.innerHTML;
		template.remove();

		const failsafe = setTimeout(() => iframe.setAttribute('data-loaded', ''), SKELETON_MAX_WAIT_MS);
		iframe.addEventListener(
			'load',
			() => {
				clearTimeout(failsafe);
				iframe.setAttribute('data-loaded', '');
			},
			{ once: true },
		);
	}

	/**
	 * A page can stack many `<CodeComponent />` blocks; without this every one
	 * of their iframes would start fetching its remote assets at once. Instead
	 * each stays inert (see the `<template>` next to it) until it scrolls near
	 * the viewport.
	 */
	function lazyLoadPreviews() {
		const frames = Array.from(
			document.querySelectorAll<HTMLIFrameElement>('[data-cc-iframe]:not([data-cc-queued])'),
		);
		if (frames.length === 0) return;

		if (!('IntersectionObserver' in window)) {
			frames.forEach((iframe) => {
				iframe.setAttribute('data-cc-queued', '');
				activatePreview(iframe);
			});
			return;
		}

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					observer.unobserve(entry.target);
					activatePreview(entry.target as HTMLIFrameElement);
				}
			},
			{ rootMargin: PREVIEW_ROOT_MARGIN },
		);

		frames.forEach((iframe) => {
			iframe.setAttribute('data-cc-queued', '');
			observer.observe(iframe);
		});
	}

	function initAll() {
		document
			.querySelectorAll<HTMLElement>('[data-cc]:not([data-cc-ready])')
			.forEach(setup);
		lazyLoadPreviews();
	}

	initAll();
	document.addEventListener('astro:after-swap', initAll);
	document.addEventListener('starwind:init', initAll);
</script>
