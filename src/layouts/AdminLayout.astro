---
import "../styles/starwind.css";
import { ThemeInitScript } from "@starwind-ui/astro/theme";

import AdminNavbar from "../components/admin/AdminNavbar.astro";

interface Props {
	title: string;
	/**
	 * Off for pages that live on this layout without being part of the admin
	 * itself — the login screen, where admin links would lead nowhere.
	 */
	nav?: boolean;
}

const { title, nav = true } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<ThemeInitScript />
		<title>{title}</title>
	</head>
	<body>
		{nav && <AdminNavbar />}
		<!-- Padding rather than margin: the pages' own top margin would collapse
		     through it and slide their headers under the fixed bar. -->
		<div class={nav ? 'pt-20 md:pt-24' : undefined}>
			<slot />
		</div>
		<div class="fixed inset-0 -z-10 h-full w-full bg-neutral-50 dark:bg-neutral-900 bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-size-[14px_24px]"></div>
	</body>
</html>
