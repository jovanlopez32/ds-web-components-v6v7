---
import Layout from '../layouts/PublicLayout.astro';

import { Tooltip, TooltipTrigger, TooltipContent } from "@/components/starwind/tooltip";
import { Button } from "@/components/starwind/button";
import {
  Combobox,
  ComboboxContent,
  ComboboxEmpty,
  ComboboxInput,
  ComboboxItem,
  ComboboxLabel,
} from "@/components/starwind/combobox";
import { Dropzone, DropzoneFilesList, DropzoneLoadingIndicator, DropzoneUploadIndicator } from "@/components/starwind/dropzone";
import { Separator } from "@/components/starwind/separator";
---


<Layout title="LeadVenture">
  <main>

    <div style="text-align: center;">
      <h1 class="font-bold px-4" style="color:blueviolet; font-size: clamp(1.375rem, 7vw, 30px); text-align:center">My Astro & Vue Site Lu Arvizu</h1>
      <!-- IMPORTANT: Add a client directive for interactivity -->

    </div>

  <Separator />

  <div class="flex flex-wrap items-center gap-4 px-4 py-16 text-sm sm:px-10 sm:py-24">
    <div>
        <Tooltip>
          <TooltipTrigger>
            <Button variant="outline">Hover me</Button>
          </TooltipTrigger>
          <TooltipContent>
            Add to library
          </TooltipContent>
        </Tooltip>
    </div>
    <Separator orientation="vertical" />
    <div>
        <Combobox name="framework" required>
        <ComboboxLabel>Favorite Type Music?</ComboboxLabel>
        <ComboboxInput placeholder="Search options" />
        <ComboboxContent>
          <ComboboxEmpty>No framework found.</ComboboxEmpty>
          <ComboboxItem value="astro">Rock</ComboboxItem>
          <ComboboxItem value="react">Pop</ComboboxItem>
          <ComboboxItem value="vue">Hip Hop</ComboboxItem>
          <ComboboxItem value="svelte">Classic</ComboboxItem>
        </ComboboxContent>
      </Combobox>
    </div>
  </div>


  <Separator />
    
  <div class="mt-12 w-full max-w-[400px] px-4 sm:px-10">
    <Dropzone />
  </div>

    


    

  </main>
</Layout>





