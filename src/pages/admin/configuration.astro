---
export const prerender = false;

import { actions } from 'astro:actions';
import Layout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '@/components/admin/AdminPageHeader.astro';
import { createUserClient } from '../../lib/supabase';
import { loadPreviewSettings } from '../../lib/settings';
import { Button } from '@/components/starwind/button';
import { Label } from '@/components/starwind/label';
import { Textarea } from '@/components/starwind/textarea';

const accessToken = Astro.cookies.get('sb-access-token')?.value;

if (!accessToken) {
	return Astro.redirect('/login');
}

const db = createUserClient(accessToken);
const settings = await loadPreviewSettings(db);

// No island here: a plain form posting to the action keeps this page working
// without any client-side JavaScript.
const result = Astro.getActionResult(actions.settings.save);
---

<Layout title="Configuration">
	<main class="admin">
		<AdminPageHeader title="Configuration" backHref="/admin" />

		<p class="intro">
			These values define the environment in which each component's preview renders, so
			it behaves the same as the real platform.
		</p>

		{result?.error && <p class="error">Could not save: {result.error.message}</p>}
		{result && !result.error && <p class="ok">Configuration saved.</p>}

		<form method="POST" action={actions.settings.save}>
			<Label for="previewCssUrls">External stylesheets</Label>
			<p class="help">
				One URL per line, injected as <code>&lt;link&gt;</code> only in the preview —
				never in this admin. This is where icon fonts and any external CSS the
				platform loads in its <code>&lt;head&gt;</code> go (Font Awesome, iconmonstr).
				<code>//</code> URLs are pinned to <code>https:</code> automatically.
			</p>
			<Textarea id="previewCssUrls" name="previewCssUrls" rows="4" spellcheck="false"
				>{settings.previewCssUrls.join('\n')}</Textarea
			>

			<Label for="previewJsUrls">Scripts</Label>
			<p class="help">
				One URL per line, loaded before the component's JS. This is where jQuery goes.
				Vanilla JS needs nothing extra: it works the same with or without jQuery
				loaded, so they don't need to be kept separate.
			</p>
			<Textarea id="previewJsUrls" name="previewJsUrls" rows="3" spellcheck="false"
				>{settings.previewJsUrls.join('\n')}</Textarea
			>

			<Label for="previewLessVariables">Site variables (LESS)</Label>
			<p class="help">
				Only the variables that <strong>change from site to site</strong>:
				<code>@black</code>, <code>@index-primary</code>, <code>@img-path</code>. Platform
				mixins and variables <strong>no longer go here</strong>: they are read straight
				from the real files in <code>src/v6v7/_platform-less-ref</code> at compile time,
				so <code>.container</code>, <code>.transition()</code>, or <code>@screen-lg-min</code>
				work without declaring anything. If a component uses a theme variable that isn't
				here, compilation fails and you'll see the error in the editor.
			</p>
			<Textarea id="previewLessVariables" name="previewLessVariables" rows="10" spellcheck="false"
				>{settings.previewLessVariables}</Textarea
			>

			<Button type="submit" variant="primary" class="save-button">Save configuration</Button>
		</form>
	</main>
</Layout>

<style>
	.admin {
		max-width: 760px;
		margin: 2rem auto;
		padding: 0 1rem;
	}
	.intro {
		margin-top: 0.75rem;
		color: var(--muted-foreground);
	}
	.error,
	.ok {
		margin-top: 1.25rem;
		padding: 0.6rem 0.85rem;
		border-radius: 4px;
		font-size: 0.875rem;
		color: var(--foreground);
	}
	.error {
		background: color-mix(in oklch, var(--error), transparent 90%);
		border: 1px solid color-mix(in oklch, var(--error), transparent 60%);
	}
	.ok {
		background: color-mix(in oklch, var(--success), transparent 90%);
		border: 1px solid color-mix(in oklch, var(--success), transparent 60%);
	}
	form {
		display: flex;
		flex-direction: column;
		margin-top: 1.5rem;
	}
	form > :global([data-slot='label']) {
		margin-top: 1.5rem;
	}
	.help {
		margin: 0.35rem 0 0.5rem;
		color: var(--muted-foreground);
		font-size: 0.8125rem;
		line-height: 1.5;
	}
	.help code {
		background: var(--muted);
		color: var(--foreground);
		padding: 0.05rem 0.3rem;
		border-radius: 3px;
	}
	:global(textarea[data-slot='textarea']) {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.8125rem;
		resize: vertical;
	}
	.save-button {
		align-self: flex-start;
		margin-top: 1.75rem;
	}
</style>
