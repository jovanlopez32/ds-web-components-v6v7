---
export const prerender = false;

import Layout from '../../../layouts/AdminLayout.astro';
import { Button } from '@/components/starwind/button';
import { Input } from '@/components/starwind/input';
import { Label } from '@/components/starwind/label';

const error = Astro.url.searchParams.get('error');
---

<Layout title="Crear cuenta de admin">
	<main class="new-user">
		<a href="/admin">&larr; Volver</a>
		<form action="/api/admin/create-user" method="post">
			<h1>Crear cuenta de admin</h1>
			{error && <p class="error">{error === 'missing_fields' ? 'Ingresa correo y contraseña.' : error}</p>}
			<Label for="email">Correo</Label>
			<Input type="email" name="email" id="email" required autocomplete="email" />
			<Label for="password">Contraseña temporal</Label>
			<Input type="password" name="password" id="password" required minlength={8} autocomplete="new-password" />
			<Button type="submit">Crear cuenta</Button>
		</form>
	</main>
</Layout>

<style>
	.new-user {
		max-width: 320px;
		margin: 2rem auto;
		padding: 0 1rem;
	}
	form {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin-top: 1rem;
	}
	.error {
		color: #b91c1c;
		margin: 0;
	}
</style>
