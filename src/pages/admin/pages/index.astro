---
export const prerender = false;

import { actions, isInputError } from 'astro:actions';
import Layout from '../../../layouts/AdminLayout.astro';
import AdminNav from '../../../components/AdminNav.astro';
import { createUserClient } from '../../../lib/supabase';
import { Button } from '@/components/starwind/button';
import { Input } from '@/components/starwind/input';
import { Label } from '@/components/starwind/label';
import { NativeSelect } from '@/components/starwind/native-select';
import { Textarea } from '@/components/starwind/textarea';
import {
	AlertDialog,
	AlertDialogTrigger,
	AlertDialogContent,
	AlertDialogHeader,
	AlertDialogTitle,
	AlertDialogFooter,
	AlertDialogCancel,
	AlertDialogAction,
} from '@/components/starwind/alert-dialog';

const accessToken = Astro.cookies.get('sb-access-token')?.value;

if (!accessToken) {
	return Astro.redirect('/login');
}

const db = createUserClient(accessToken);

const { data: pages, error } = await db
	.from('pages')
	.select('id, parent_id, title, slug, admin_slug, description')
	.order('position');

const createResult = Astro.getActionResult(actions.pages.create);
const inputErrors = isInputError(createResult?.error) ? createResult.error.fields : {};

// Group into two levels for display. Only top-level pages can be parents, so
// this is the whole tree; see the check constraint note in the init migration.
const topLevel = (pages ?? []).filter((page) => !page.parent_id);
const childrenOf = (parentId: string) => (pages ?? []).filter((page) => page.parent_id === parentId);
---

<Layout title="Pages">
	<main class="pages">
		<header>
			<h1>Pages</h1>
			<a href="/admin">&larr; Volver al dashboard</a>
		</header>
		<AdminNav current="pages" />

		{error && <p class="error">No se pudieron cargar las pages.</p>}
		{createResult?.error && !isInputError(createResult.error) && (
			<p class="error">{createResult.error.message}</p>
		)}
		{Object.keys(inputErrors).length > 0 && (
			<p class="error">{Object.values(inputErrors).flat().join(' ')}</p>
		)}

		<AlertDialog>
			<AlertDialogTrigger asChild class="open-create-page">
				<Button type="button">Nueva page</Button>
			</AlertDialogTrigger>

			<AlertDialogContent>
				<form method="POST" action={actions.pages.create} class="create-page-form">
					<AlertDialogHeader>
						<AlertDialogTitle>Nueva page</AlertDialogTitle>
					</AlertDialogHeader>

					<div class="create-page-fields">
						<Label for="title">Título</Label>
						<Input type="text" name="title" id="title" required />

						<Label for="slug">Slug público</Label>
						<Input type="text" name="slug" id="slug" required pattern="[a-z0-9-]+" placeholder="mi-page" />

						<Label for="parentId">Page padre</Label>
						<!--
							Only top-level pages are offered, which keeps the tree two
							levels deep and makes a parent cycle impossible to create
							through the UI.
						-->
						<NativeSelect name="parentId" id="parentId">
							<option value="">Ninguna (page principal)</option>
							{topLevel.map((page) => <option value={page.id}>{page.title}</option>)}
						</NativeSelect>

						<Label for="description">Descripción</Label>
						<Textarea name="description" id="description" rows="3" />
					</div>

					<AlertDialogFooter>
						<AlertDialogCancel>Cancelar</AlertDialogCancel>
						<AlertDialogAction type="submit">Crear</AlertDialogAction>
					</AlertDialogFooter>
				</form>
			</AlertDialogContent>
		</AlertDialog>

		{topLevel.length === 0 && <p class="empty">Todavía no hay pages.</p>}

		<ul class="page-list">
			{topLevel.map((page) => (
				<li data-id={page.id}>
					<div class="page-row">
						<span class="drag-handle" title="Arrastrar para reordenar">
							<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
								<circle cx="9" cy="6" r="1.5" /><circle cx="15" cy="6" r="1.5" />
								<circle cx="9" cy="12" r="1.5" /><circle cx="15" cy="12" r="1.5" />
								<circle cx="9" cy="18" r="1.5" /><circle cx="15" cy="18" r="1.5" />
							</svg>
						</span>
						<div>
							<strong>{page.title}</strong>
							<a class="slug" href={`/${page.slug}`} target="_blank">/{page.slug}</a>
							{page.description && <p>{page.description}</p>}
						</div>
						<div class="page-actions">
							<a class="manage" href={`/admin/pages/${page.admin_slug}`}>Gestionar</a>
							<form
								method="POST"
								action={actions.pages.remove}
								onsubmit="return confirm('¿Eliminar esta page? También se borran sus subpáginas y componentes.')"
							>
								<input type="hidden" name="id" value={page.id} />
								<Button type="submit" variant="error" size="sm">Eliminar</Button>
							</form>
						</div>
					</div>

					{childrenOf(page.id).length > 0 && (
						<ul class="subpage-list">
							{childrenOf(page.id).map((child) => (
								<li class="page-row" data-id={child.id}>
									<span class="drag-handle" title="Arrastrar para reordenar">
										<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
											<circle cx="9" cy="6" r="1.5" /><circle cx="15" cy="6" r="1.5" />
											<circle cx="9" cy="12" r="1.5" /><circle cx="15" cy="12" r="1.5" />
											<circle cx="9" cy="18" r="1.5" /><circle cx="15" cy="18" r="1.5" />
										</svg>
									</span>
									<div>
										<strong>{child.title}</strong>
										<a class="slug" href={`/${child.slug}`} target="_blank">/{child.slug}</a>
										{child.description && <p>{child.description}</p>}
									</div>
									<div class="page-actions">
										<a class="manage" href={`/admin/pages/${child.admin_slug}`}>Gestionar</a>
										<form
											method="POST"
											action={actions.pages.remove}
											onsubmit="return confirm('¿Eliminar esta subpágina y sus componentes?')"
										>
											<input type="hidden" name="id" value={child.id} />
											<Button type="submit" variant="error" size="sm">Eliminar</Button>
										</form>
									</div>
								</li>
							))}
						</ul>
					)}
				</li>
			))}
		</ul>
	</main>
</Layout>

<script>
	import { actions } from 'astro:actions';
	import Sortable from 'sortablejs';

	// One Sortable per sibling group: the top-level list and each subpage
	// list are kept separate so a drag never crosses between levels.
	function makeSortable(el: Element | null, reorder: typeof actions.pages.reorder) {
		if (!el) return;
		Sortable.create(el as HTMLElement, {
			handle: '.drag-handle',
			animation: 150,
			onEnd: async () => {
				const ids = Array.from(el.children).map((li) => (li as HTMLElement).dataset.id!);
				const { error } = await reorder({ ids });
				if (error) {
					alert('No se pudo guardar el nuevo orden.');
					location.reload();
				}
			},
		});
	}

	makeSortable(document.querySelector('.page-list'), actions.pages.reorder);
	document.querySelectorAll('.subpage-list').forEach((el) => makeSortable(el, actions.pages.reorder));

	// Derive the slug from the title until the author edits the slug themselves.
	const titleInput = document.getElementById('title') as HTMLInputElement | null;
	const slugInput = document.getElementById('slug') as HTMLInputElement | null;
	let slugTouched = false;
	slugInput?.addEventListener('input', () => {
		slugTouched = true;
	});
	titleInput?.addEventListener('input', () => {
		if (slugTouched || !slugInput || !titleInput) return;
		slugInput.value = titleInput.value
			.toLowerCase()
			.trim()
			.replace(/[^a-z0-9]+/g, '-')
			.replace(/^-+|-+$/g, '');
	});
</script>

<style>
	.pages {
		max-width: 800px;
		margin: 2rem auto;
		padding: 0 1rem;
	}
	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	header a {
		color: #6b7280;
		text-decoration: none;
	}
	.error {
		padding: 0.6rem 0.85rem;
		border-radius: 4px;
		background: #fef2f2;
		border: 1px solid #fecaca;
		color: #b91c1c;
		font-size: 0.875rem;
	}
	.empty {
		color: #6b7280;
	}
	.open-create-page {
		margin-bottom: 1.25rem;
	}
	.create-page-form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}
	.create-page-fields {
		display: flex;
		flex-direction: column;
	}
	.create-page-fields :global([data-slot='label']) {
		margin-top: 0.9rem;
		margin-bottom: 0.25rem;
	}
	.create-page-fields :global([data-slot='label']):first-child {
		margin-top: 0;
	}
	.page-list,
	.subpage-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.page-list {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.page-row {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.7rem 1rem;
		border: 1px solid #e5e7eb;
		border-radius: 6px;
	}
	.page-row > div:not(.page-actions) {
		flex: 1;
	}
	.page-row p {
		margin: 0.25rem 0 0;
		color: #6b7280;
		font-size: 0.875rem;
	}
	.drag-handle {
		display: flex;
		flex-shrink: 0;
		color: #9ca3af;
		cursor: grab;
		touch-action: none;
	}
	.drag-handle:active {
		cursor: grabbing;
	}
	.sortable-ghost {
		opacity: 0.4;
	}
	.sortable-drag {
		background: #f9fafb;
	}
	.slug {
		display: block;
		color: #6b7280;
		font-size: 0.8125rem;
		text-decoration: none;
	}
	.page-actions {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex-shrink: 0;
	}
	.manage {
		color: #111827;
		font-size: 0.875rem;
		font-weight: 600;
	}
	/* Subpages are indented and marked with a rule, so the hierarchy reads at
	   a glance without needing a disclosure control. */
	.subpage-list {
		margin: 0.5rem 0 0 1.75rem;
		padding-left: 0.75rem;
		border-left: 2px solid #e5e7eb;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
</style>
