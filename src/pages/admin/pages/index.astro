---
export const prerender = false;

import { actions, isInputError } from 'astro:actions';
import Layout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '@/components/admin/AdminPageHeader.astro';
import { createUserClient } from '../../../lib/supabase';
import { Button } from '@/components/starwind/button';
import { Input } from '@/components/starwind/input';
import { Label } from '@/components/starwind/label';
import { NativeSelect } from '@/components/starwind/native-select';
import { Textarea } from '@/components/starwind/textarea';
import {
	AlertDialog,
	AlertDialogTrigger,
	AlertDialogContent,
	AlertDialogHeader,
	AlertDialogTitle,
	AlertDialogFooter,
	AlertDialogCancel,
	AlertDialogAction,
} from '@/components/starwind/alert-dialog';
import IconPlus from '@tabler/icons/outline/plus.svg';
import IconGripVertical from '@tabler/icons/outline/grip-vertical.svg';
import IconChevronRight from '@tabler/icons/outline/chevron-right.svg';
import IconExternalLink from '@tabler/icons/outline/external-link.svg';
import IconTrash from '@tabler/icons/outline/trash.svg';
import IconSitemap from '@tabler/icons/outline/sitemap.svg';

const accessToken = Astro.cookies.get('sb-access-token')?.value;

if (!accessToken) {
	return Astro.redirect('/login');
}

const db = createUserClient(accessToken);

const { data: pages, error } = await db
	.from('pages')
	.select('id, parent_id, title, slug, admin_slug, description')
	.order('position');

const createResult = Astro.getActionResult(actions.pages.create);
const inputErrors = isInputError(createResult?.error) ? createResult.error.fields : {};

// Group into two levels for display. Only top-level pages can be parents, so
// this is the whole tree; see the check constraint note in the init migration.
const topLevel = (pages ?? []).filter((page) => !page.parent_id);
const childrenOf = (parentId: string) => (pages ?? []).filter((page) => page.parent_id === parentId);

const childCount = (pages ?? []).length - topLevel.length;
const plural = (count: number, one: string, many: string) => `${count} ${count === 1 ? one : many}`;

const summary =
	topLevel.length === 0
		? undefined
		: `${plural(topLevel.length, 'page principal', 'pages principales')} y ${plural(childCount, 'subpágina', 'subpáginas')}. Arrastra para reordenar.`;
---

<Layout title="Pages">
	<main class="mx-auto w-full max-w-3xl px-4 pb-20 sm:px-6">
		<AdminPageHeader title="Pages" backHref="/admin" description={summary}>
			<AlertDialog slot="actions" class="w-full sm:w-auto">
				<AlertDialogTrigger asChild>
					<Button type="button" size="sm" class="w-full sm:w-auto">
						<IconPlus class="size-4" aria-hidden="true" />
						Nueva page
					</Button>
				</AlertDialogTrigger>

				<AlertDialogContent>
					<form method="POST" action={actions.pages.create}>
						<AlertDialogHeader>
							<AlertDialogTitle>Nueva page</AlertDialogTitle>
						</AlertDialogHeader>

						<div class="mt-5 flex flex-col gap-4">
							<div class="flex flex-col gap-2">
								<Label for="title">Título</Label>
								<Input type="text" name="title" id="title" required />
							</div>

							<div class="flex flex-col gap-2">
								<Label for="slug">Slug público</Label>
								<Input
									type="text"
									name="slug"
									id="slug"
									required
									pattern="[a-z0-9-]+"
									placeholder="mi-page"
								/>
							</div>

							<div class="flex flex-col gap-2">
								<Label for="parentId">Page padre</Label>
								<!--
									Only top-level pages are offered, which keeps the tree two
									levels deep and makes a parent cycle impossible to create
									through the UI.
								-->
								<NativeSelect name="parentId" id="parentId">
									<option value="">Ninguna (page principal)</option>
									{topLevel.map((page) => <option value={page.id}>{page.title}</option>)}
								</NativeSelect>
							</div>

							<div class="flex flex-col gap-2">
								<Label for="description">Descripción</Label>
								<Textarea name="description" id="description" rows="3" />
							</div>
						</div>

						<AlertDialogFooter class="mt-6">
							<AlertDialogCancel>Cancelar</AlertDialogCancel>
							<AlertDialogAction type="submit">Crear</AlertDialogAction>
						</AlertDialogFooter>
					</form>
				</AlertDialogContent>
			</AlertDialog>
		</AdminPageHeader>

		{error && (
			<p class="mt-6 rounded-md border border-error/40 bg-error/10 px-4 py-3 text-sm text-foreground">
				No se pudieron cargar las pages.
			</p>
		)}
		{createResult?.error && !isInputError(createResult.error) && (
			<p class="mt-6 rounded-md border border-error/40 bg-error/10 px-4 py-3 text-sm text-foreground">
				{createResult.error.message}
			</p>
		)}
		{Object.keys(inputErrors).length > 0 && (
			<p class="mt-6 rounded-md border border-error/40 bg-error/10 px-4 py-3 text-sm text-foreground">
				{Object.values(inputErrors).flat().join(' ')}
			</p>
		)}

		{topLevel.length === 0 && !error && (
			<div class="mt-8 flex flex-col items-center gap-3 rounded-lg border border-dashed border-border px-6 py-12 text-center">
				<IconSitemap class="size-8 text-muted-foreground" aria-hidden="true" />
				<p class="text-base font-medium text-foreground">Todavía no hay pages</p>
				<p class="max-w-[40ch] text-sm text-muted-foreground">
					Crea la primera page y después cuélgale subpáginas eligiéndola como page padre.
				</p>
			</div>
		)}

		<ul class="page-list mt-8 flex flex-col gap-3">
			{topLevel.map((page) => {
				const children = childrenOf(page.id);

				return (
					<li class="overflow-hidden rounded-lg border border-border bg-card" data-id={page.id}>
						{/*
							Wraps on purpose: the actions block is `w-full` below `sm`, which
							pushes it onto its own line instead of squeezing the title into a
							two-character column on a phone.
						*/}
						<div class="flex flex-wrap items-start gap-x-3 gap-y-3 p-3 sm:p-4">
							<span
								class="drag-handle mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
								title="Arrastrar para reordenar"
							>
								<IconGripVertical class="size-4" aria-hidden="true" />
							</span>

							<div class="min-w-0 flex-1 basis-40">
								<strong class="block text-base font-semibold text-foreground">{page.title}</strong>
								<a
									href={`/${page.slug}`}
									target="_blank"
									rel="noreferrer"
									class="mt-0.5 inline-flex max-w-full items-center gap-1 truncate text-xs text-muted-foreground transition-colors hover:text-foreground"
								>
									/{page.slug}
									<IconExternalLink class="size-3 shrink-0" aria-hidden="true" />
								</a>

								{page.description && (
									<p class="mt-1 line-clamp-2 text-sm text-muted-foreground">{page.description}</p>
								)}
							</div>

							<div class="flex w-full items-center gap-2 sm:w-auto">
								<Button
									as="a"
									href={`/admin/pages/${page.admin_slug}`}
									variant="outline"
									size="sm"
									class="flex-1 sm:flex-none"
								>
									Gestionar
								</Button>
								{/*
									Icon-only: the destructive action keeps its colour without
									taking half the row's width away from Gestionar on a phone.
								*/}
								<form
									method="POST"
									action={actions.pages.remove}
									class="shrink-0"
									data-confirm="¿Eliminar esta page? También se borran sus subpáginas y componentes."
								>
									<input type="hidden" name="id" value={page.id} />
									<Button
										type="submit"
										variant="error"
										size="icon-sm"
										title="Eliminar page"
										aria-label={`Eliminar ${page.title}`}
									>
										<IconTrash class="size-4" aria-hidden="true" />
									</Button>
								</form>
							</div>
						</div>

						{/*
							Native <details> rather than a scripted panel: the count is always
							visible, the group collapses without any JavaScript, and nothing
							can flash open before a hydration step runs.
						*/}
						{children.length > 0 ? (
							<details class="subpages group border-t border-border">
								<summary class="flex cursor-pointer list-none items-center gap-2 px-3 py-2.5 text-xs font-medium text-foreground outline-none transition-colors hover:bg-muted focus-visible:ring-3 focus-visible:ring-outline/50 focus-visible:ring-inset sm:px-4 [&::-webkit-details-marker]:hidden">
									<IconChevronRight
										class="size-3.5 text-muted-foreground transition-transform duration-200 group-open:rotate-90 motion-reduce:transition-none"
										aria-hidden="true"
									/>
									{plural(children.length, 'subpágina', 'subpáginas')}
								</summary>

								<ul class="subpage-list flex flex-col gap-2 px-3 pt-1 pb-3 sm:px-4 sm:pb-4">
									{children.map((child) => (
										<li
											class="flex flex-wrap items-start gap-x-3 gap-y-3 rounded-md border border-border bg-muted/40 p-2.5 sm:p-3"
											data-id={child.id}
										>
											<span
												class="drag-handle mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
												title="Arrastrar para reordenar"
											>
												<IconGripVertical class="size-4" aria-hidden="true" />
											</span>

											<div class="min-w-0 flex-1 basis-40">
												<strong class="block text-sm font-semibold text-foreground">{child.title}</strong>
												<a
													href={`/${child.slug}`}
													target="_blank"
													rel="noreferrer"
													class="mt-0.5 inline-flex max-w-full items-center gap-1 truncate text-xs text-muted-foreground transition-colors hover:text-foreground"
												>
													/{child.slug}
													<IconExternalLink class="size-3 shrink-0" aria-hidden="true" />
												</a>
												{child.description && (
													<p class="mt-1 line-clamp-2 text-sm text-muted-foreground">
														{child.description}
													</p>
												)}
											</div>

											<div class="flex w-full items-center gap-2 sm:w-auto">
												<Button
													as="a"
													href={`/admin/pages/${child.admin_slug}`}
													variant="outline"
													size="sm"
													class="flex-1 sm:flex-none"
												>
													Gestionar
												</Button>
												<form
													method="POST"
													action={actions.pages.remove}
													class="shrink-0"
													data-confirm="¿Eliminar esta subpágina y sus componentes?"
												>
													<input type="hidden" name="id" value={child.id} />
													<Button
														type="submit"
														variant="error"
														size="icon-sm"
														title="Eliminar subpágina"
														aria-label={`Eliminar ${child.title}`}
													>
														<IconTrash class="size-4" aria-hidden="true" />
													</Button>
												</form>
											</div>
										</li>
									))}
								</ul>
							</details>
						) : (
							<p class="border-t border-border px-3 py-2.5 text-xs text-muted-foreground sm:px-4">
								Sin subpáginas
							</p>
						)}
					</li>
				);
			})}
		</ul>
	</main>
</Layout>

<script>
	import { actions } from 'astro:actions';
	import Sortable from 'sortablejs';

	// One Sortable per sibling group: the top-level list and each subpage
	// list are kept separate so a drag never crosses between levels.
	function makeSortable(el: Element | null, reorder: typeof actions.pages.reorder) {
		if (!el) return;
		Sortable.create(el as HTMLElement, {
			handle: '.drag-handle',
			animation: 150,
			onEnd: async () => {
				const ids = Array.from(el.children).map((li) => (li as HTMLElement).dataset.id!);
				const { error } = await reorder({ ids });
				if (error) {
					alert('No se pudo guardar el nuevo orden.');
					location.reload();
				}
			},
		});
	}

	makeSortable(document.querySelector('.page-list'), actions.pages.reorder);
	document.querySelectorAll('.subpage-list').forEach((el) => makeSortable(el, actions.pages.reorder));

	// The delete forms post straight to the action, so they keep working without
	// JavaScript — this only adds the confirmation step when it is available.
	document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((form) => {
		form.addEventListener('submit', (event) => {
			if (!confirm(form.dataset.confirm!)) event.preventDefault();
		});
	});

	// Derive the slug from the title until the author edits the slug themselves.
	const titleInput = document.getElementById('title') as HTMLInputElement | null;
	const slugInput = document.getElementById('slug') as HTMLInputElement | null;
	let slugTouched = false;
	slugInput?.addEventListener('input', () => {
		slugTouched = true;
	});
	titleInput?.addEventListener('input', () => {
		if (slugTouched || !slugInput || !titleInput) return;
		slugInput.value = titleInput.value
			.toLowerCase()
			.trim()
			.replace(/[^a-z0-9]+/g, '-')
			.replace(/^-+|-+$/g, '');
	});
</script>

<style>
	.drag-handle {
		cursor: grab;
		touch-action: none;
	}
	.drag-handle:active {
		cursor: grabbing;
	}
	.sortable-ghost {
		opacity: 0.4;
	}
	.sortable-drag {
		background: var(--muted);
	}

	/* Animates the disclosure where `::details-content` and `interpolate-size`
	   are supported, and simply snaps open where they aren't. */
	.subpages {
		interpolate-size: allow-keywords;
	}
	.subpages::details-content {
		height: 0;
		overflow: hidden;
		transition:
			height 0.25s ease,
			content-visibility 0.25s;
		transition-behavior: allow-discrete;
	}
	.subpages[open]::details-content {
		height: auto;
	}
	@media (prefers-reduced-motion: reduce) {
		.subpages::details-content {
			transition: none;
		}
	}
</style>
