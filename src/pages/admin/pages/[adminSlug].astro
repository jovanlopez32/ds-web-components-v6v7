---
export const prerender = false;

import { actions } from 'astro:actions';
import Layout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '@/components/admin/AdminPageHeader.astro';
import { createUserClient } from '../../../lib/supabase';
import { Button } from '@/components/starwind/button';

const { adminSlug } = Astro.params;
const accessToken = Astro.cookies.get('sb-access-token')?.value;

if (!accessToken) {
	return Astro.redirect('/login');
}

const db = createUserClient(accessToken);

const { data: page } = await db
	.from('pages')
	.select('id, title, slug, admin_slug, description')
	.eq('admin_slug', adminSlug)
	.maybeSingle();

if (!page) {
	return Astro.redirect('/admin/pages');
}

const { data: components } = await db
	.from('components')
	.select('id, ref, title, created_by_email, updated_at')
	.eq('page_id', page.id)
	.order('position');

const errorCode = Astro.url.searchParams.get('error');
---

<Layout title={`Page: ${page.title}`}>
	<main class="page-detail">
		<AdminPageHeader title={page.title} backHref="/admin/pages" backLabel="Back to Pages" description={page.description} />

		<p class="slug">Public: <a href={`/${page.slug}`} target="_blank">/{page.slug}</a></p>

		{errorCode && <p class="error">An error occurred, please try again.</p>}

		<div class="components-header">
			<h2>Components</h2>
			<Button as="a" href={`/admin/pages/${page.admin_slug}/components/new`} size="sm">New component</Button>
		</div>

		{components && components.length === 0 && <p>No components yet.</p>}

		<ul class="component-list">
			{components?.map((component) => (
				<li data-id={component.id}>
					<span class="drag-handle" title="Drag to reorder">
						<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
							<circle cx="9" cy="6" r="1.5" /><circle cx="15" cy="6" r="1.5" />
							<circle cx="9" cy="12" r="1.5" /><circle cx="15" cy="12" r="1.5" />
							<circle cx="9" cy="18" r="1.5" /><circle cx="15" cy="18" r="1.5" />
						</svg>
					</span>
					<div class="component-info">
						<span class="component-title">{component.title}</span>
						<span class="component-meta">
							<code>&lt;CodeComponent id="{component.ref}" /&gt;</code>
							{component.created_by_email && <> · {component.created_by_email}</>}
							{' · '}
							{new Date(component.updated_at).toLocaleDateString('en-US', {
								dateStyle: 'medium',
							})}
						</span>
					</div>
					<div class="actions">
						<a href={`/admin/pages/${page.admin_slug}/components/${component.id}`}>Edit</a>
						<!--
							Posts straight to the action, so this delete keeps
							working with JavaScript disabled. The editor island
							calls the same action with a FormData.
						-->
						<form
							method="POST"
							action={actions.components.remove}
							onsubmit="return confirm('Delete this component?')"
						>
							<input type="hidden" name="id" value={component.id} />
							<Button type="submit" variant="error" size="sm">Delete</Button>
						</form>
					</div>
				</li>
			))}
		</ul>
	</main>
</Layout>

<script>
	import { actions } from 'astro:actions';
	import Sortable from 'sortablejs';

	const list = document.querySelector('.component-list');
	if (list) {
		Sortable.create(list as HTMLElement, {
			handle: '.drag-handle',
			animation: 150,
			onEnd: async () => {
				const ids = Array.from(list.children).map((li) => (li as HTMLElement).dataset.id!);
				const { error } = await actions.components.reorder({ ids });
				if (error) {
					alert('Could not save the new order.');
					location.reload();
				}
			},
		});
	}
</script>

<style>
	.page-detail {
		max-width: 720px;
		margin: 2rem auto;
		padding: 0 1rem;
	}
	.slug {
		margin-top: 0.75rem;
		color: var(--muted-foreground);
	}
	.slug a {
		color: var(--muted-foreground);
		text-decoration-color: color-mix(in oklch, var(--muted-foreground), transparent 60%);
	}
	.slug a:hover {
		color: var(--foreground);
	}
	.error {
		margin-top: 1rem;
		padding: 0.6rem 0.85rem;
		border-radius: 4px;
		font-size: 0.875rem;
		color: var(--foreground);
		background: color-mix(in oklch, var(--error), transparent 90%);
		border: 1px solid color-mix(in oklch, var(--error), transparent 60%);
	}
	.components-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		margin-top: 1.5rem;
	}
	.component-list {
		list-style: none;
		padding: 0;
		margin: 1rem 0 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	/* Wraps on a phone: Edit plus Delete take 130px of a 326px row, which
	   leaves the title and its <CodeComponent> snippet fighting over what is
	   left. Below sm the actions drop onto their own full-width line instead. */
	.component-list li {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 0.75rem 1rem;
		padding: 0.6rem 1rem;
		border: 1px solid var(--border);
		border-radius: 6px;
	}
	.drag-handle {
		display: flex;
		flex-shrink: 0;
		color: var(--muted-foreground);
		cursor: grab;
		touch-action: none;
	}
	.drag-handle:active {
		cursor: grabbing;
	}
	.sortable-ghost {
		opacity: 0.4;
	}
	.sortable-drag {
		background: var(--muted);
	}
	.component-info {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
		flex: 1 1 12rem;
	}
	.component-title {
		font-weight: 600;
	}
	.component-meta {
		color: var(--muted-foreground);
		font-size: 0.75rem;
		overflow-wrap: anywhere;
	}
	.component-meta code {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		background: var(--muted);
		color: var(--foreground);
		border-radius: 3px;
		padding: 0.05rem 0.3rem;
	}
	.actions {
		display: flex;
		width: 100%;
		align-items: center;
		gap: 0.75rem;
	}

	@media (min-width: 40rem) {
		.component-list li {
			flex-wrap: nowrap;
			align-items: center;
		}
		.actions {
			width: auto;
		}
	}
	.actions form {
		display: inline;
	}
	.actions a {
		color: var(--foreground);
	}
	.actions a:hover {
		color: var(--primary);
	}
</style>
