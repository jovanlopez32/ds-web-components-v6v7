---
export const prerender = false;

import { actions } from 'astro:actions';
import Layout from '../../layouts/AdminLayout.astro';
import AdminNav from '../../components/AdminNav.astro';
import { createUserClient } from '../../lib/supabase';
import { Button } from '@/components/starwind/button';
import { Input } from '@/components/starwind/input';
import { Label } from '@/components/starwind/label';

const accessToken = Astro.cookies.get('sb-access-token')?.value;

if (!accessToken) {
	return Astro.redirect('/login');
}

const db = createUserClient(accessToken);

const { data: variables } = await db
	.from('variables')
	.select('id, name, value')
	.order('name');

// Plain forms posting to actions: no island needed, so this page keeps working
// without client-side JavaScript.
const saveResult = Astro.getActionResult(actions.variables.save);
---

<Layout title="Variables globales">
	<main class="admin">
		<header>
			<h1>Variables globales</h1>
			<a href="/admin">&larr; Volver al dashboard</a>
		</header>
		<AdminNav current="variables" />

		<p class="intro">
			Sustituyen las expresiones ASP <code>&lt;%=NOMBRE%&gt;</code> en la vista previa, para
			poder ver un componente fuera de la plataforma real. Cada componente puede además
			definir las suyas, y esas ganan sobre estas.
		</p>

		{saveResult?.error && <p class="error">{saveResult.error.message}</p>}
		{saveResult && !saveResult.error && <p class="ok">Variable guardada.</p>}

		<form method="POST" action={actions.variables.save} class="new-variable">
			<div>
				<Label for="name">Nombre</Label>
				<Input
					type="text"
					id="name"
					name="name"
					required
					pattern="[A-Za-z_][A-Za-z0-9_]*"
					placeholder="TXT_IMG_PATH"
					size="sm"
				/>
			</div>
			<div>
				<Label for="value">Valor</Label>
				<Input type="text" id="value" name="value" placeholder="/images/" size="sm" />
			</div>
			<Button type="submit" size="sm">Agregar</Button>
		</form>

		{variables && variables.length === 0 && (
			<p class="empty">
				Todavía no hay variables. Agrega las que use tu ASP, por ejemplo
				<code>TXT_IMG_PATH</code> o <code>TXT_SEO_LOCATION</code>.
			</p>
		)}

		<ul class="variable-list">
			{variables?.map((variable) => (
				<li>
					{/* Each row is its own form so a single Guardar updates just that variable. */}
					<form method="POST" action={actions.variables.save}>
						<input type="hidden" name="id" value={variable.id} />
						<Input
							type="text"
							name="name"
							value={variable.name}
							required
							pattern="[A-Za-z_][A-Za-z0-9_]*"
							aria-label="Nombre"
							size="sm"
						/>
						<Input type="text" name="value" value={variable.value} aria-label="Valor" size="sm" />
						<Button type="submit" size="sm">Guardar</Button>
					</form>
					<form
						method="POST"
						action={actions.variables.remove}
						onsubmit="return confirm('¿Eliminar esta variable?')"
					>
						<input type="hidden" name="id" value={variable.id} />
						<Button type="submit" variant="error" size="sm">Eliminar</Button>
					</form>
				</li>
			))}
		</ul>
	</main>
</Layout>

<style>
	.admin {
		max-width: 900px;
		margin: 2rem auto;
		padding: 0 1rem;
	}
	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	header a {
		color: #6b7280;
		text-decoration: none;
	}
	.intro {
		color: #4b5563;
		line-height: 1.6;
	}
	code {
		background: #f3f4f6;
		padding: 0.05rem 0.3rem;
		border-radius: 3px;
		font-size: 0.875em;
	}
	.error,
	.ok {
		padding: 0.6rem 0.85rem;
		border-radius: 4px;
		font-size: 0.875rem;
	}
	.error {
		background: #fef2f2;
		border: 1px solid #fecaca;
		color: #b91c1c;
	}
	.ok {
		background: #ecfdf5;
		border: 1px solid #a7f3d0;
		color: #047857;
	}
	.new-variable {
		display: grid;
		grid-template-columns: 1fr 1fr auto;
		gap: 0.6rem;
		align-items: end;
		margin: 1.5rem 0;
		padding: 1rem;
		border: 1px solid #e5e7eb;
		border-radius: 6px;
		background: #f9fafb;
	}
	.new-variable :global([data-slot='label']) {
		display: block;
		font-size: 0.8125rem;
		margin-bottom: 0.25rem;
	}
	.empty {
		color: #6b7280;
	}
	.variable-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.variable-list li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.variable-list li > form:first-child {
		display: grid;
		grid-template-columns: 1fr 1fr auto;
		gap: 0.5rem;
		flex: 1;
		min-width: 0;
	}
	:global(input[data-slot='input']) {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		min-width: 0;
	}
</style>
