---
export const prerender = false;

import { actions } from 'astro:actions';
import Layout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '@/components/admin/AdminPageHeader.astro';
import { createUserClient } from '../../lib/supabase';
import { Button } from '@/components/starwind/button';
import { Input } from '@/components/starwind/input';
import { Label } from '@/components/starwind/label';

const accessToken = Astro.cookies.get('sb-access-token')?.value;

if (!accessToken) {
	return Astro.redirect('/login');
}

const db = createUserClient(accessToken);

const { data: variables } = await db
	.from('variables')
	.select('id, name, value')
	.order('name');

// Plain forms posting to actions: no island needed, so this page keeps working
// without client-side JavaScript.
const saveResult = Astro.getActionResult(actions.variables.save);
---

<Layout title="Global variables">
	<main class="admin">
		<AdminPageHeader title="Global variables" backHref="/admin" />

		<p class="intro">
			These replace ASP expressions <code>&lt;%=NAME%&gt;</code> in the preview, so a
			component can be viewed outside the real platform. Each component can also
			define its own, which take precedence over these.
		</p>

		{saveResult?.error && <p class="error">{saveResult.error.message}</p>}
		{saveResult && !saveResult.error && <p class="ok">Variable saved.</p>}

		<form method="POST" action={actions.variables.save} class="new-variable">
			<div>
				<Label for="name">Name</Label>
				<Input
					type="text"
					id="name"
					name="name"
					required
					pattern="[A-Za-z_][A-Za-z0-9_]*"
					placeholder="TXT_IMG_PATH"
					size="sm"
				/>
			</div>
			<div>
				<Label for="value">Value</Label>
				<Input type="text" id="value" name="value" placeholder="/images/" size="sm" />
			</div>
			<Button type="submit" variant="primary" size="sm">Add</Button>
		</form>

		{variables && variables.length === 0 && (
			<p class="empty">
				No variables yet. Add the ones your ASP code uses, for example
				<code>TXT_IMG_PATH</code> or <code>TXT_SEO_LOCATION</code>.
			</p>
		)}

		<ul class="variable-list">
			{variables?.map((variable) => (
				<li>
					{/* Each row is its own form so a single Save updates just that variable. */}
					<form method="POST" action={actions.variables.save}>
						<input type="hidden" name="id" value={variable.id} />
						<Input
							type="text"
							name="name"
							value={variable.name}
							required
							pattern="[A-Za-z_][A-Za-z0-9_]*"
							aria-label="Name"
							size="sm"
						/>
						<Input type="text" name="value" value={variable.value} aria-label="Value" size="sm" />
						<Button type="submit" size="sm">Save</Button>
					</form>
					<form
						method="POST"
						action={actions.variables.remove}
						onsubmit="return confirm('Delete this variable?')"
					>
						<input type="hidden" name="id" value={variable.id} />
						<Button type="submit" variant="error" size="sm">Delete</Button>
					</form>
				</li>
			))}
		</ul>
	</main>
</Layout>

<style>
	.admin {
		max-width: 900px;
		margin: 2rem auto;
		padding: 0 1rem;
	}
	.intro {
		margin-top: 0.75rem;
		color: var(--muted-foreground);
		line-height: 1.6;
	}
	code {
		background: var(--muted);
		color: var(--foreground);
		padding: 0.05rem 0.3rem;
		border-radius: 3px;
		font-size: 0.875em;
	}
	.error,
	.ok {
		margin-top: 1.25rem;
		padding: 0.6rem 0.85rem;
		border-radius: 4px;
		font-size: 0.875rem;
		color: var(--foreground);
	}
	.error {
		background: color-mix(in oklch, var(--error), transparent 90%);
		border: 1px solid color-mix(in oklch, var(--error), transparent 60%);
	}
	.ok {
		background: color-mix(in oklch, var(--success), transparent 90%);
		border: 1px solid color-mix(in oklch, var(--success), transparent 60%);
	}
	.new-variable {
		display: grid;
		/* One column on a phone: three side by side leaves each field about
		   70px wide, which is narrower than the variable names that go in them. */
		grid-template-columns: minmax(0, 1fr);
		gap: 0.6rem;
		align-items: end;
		margin: 1.5rem 0;
		padding: 1rem;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: color-mix(in oklch, var(--muted), transparent 40%);
	}
	.new-variable :global([data-slot='label']) {
		display: block;
		font-size: 0.8125rem;
		margin-bottom: 0.25rem;
	}
	.empty {
		color: var(--muted-foreground);
	}
	.variable-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	/* On a phone the row stacks name, value and Save, and keeps Delete in
	   its own column bottom-aligned, so the two buttons still read as one row
	   even though they belong to separate forms. */
	.variable-list li {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: 0.5rem;
	}
	.variable-list li > form:first-child {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.5rem;
		min-width: 0;
	}

	@media (min-width: 40rem) {
		.new-variable {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
		}
		.variable-list li {
			display: flex;
			align-items: center;
		}
		.variable-list li > form:first-child {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
			flex: 1;
		}
	}
	:global(input[data-slot='input']) {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		min-width: 0;
	}
</style>
