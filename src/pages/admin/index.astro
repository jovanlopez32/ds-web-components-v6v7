---
export const prerender = false;

import Layout from '../../layouts/AdminLayout.astro';
import { Button } from '@/components/starwind/button';

const user = Astro.locals.user;
---

<Layout title="Admin">
	<main class="admin">
		<header>
			<h1>Admin</h1>
			<form action="/api/auth/signout">
				<Button type="submit" size="sm">Cerrar sesión</Button>
			</form>
		</header>
		<p>Sesión iniciada como {user?.email}</p>
		<a href="/admin/users/new">Crear cuenta de admin</a>
	</main>
</Layout>

<style>
	.admin {
		max-width: 640px;
		margin: 2rem auto;
		padding: 0 1rem;
	}
	header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1rem;
	}
</style>
