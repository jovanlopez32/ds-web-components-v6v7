---
import CodeComponent from '../components/CodeComponent.astro';
import Layout from '../layouts/Layout.astro';
import { Button } from "@/components/starwind/button";
import { ButtonGroup } from "@/components/starwind/button-group";
---

<Layout title="Daniel Martínez | LeadVenture">
	<main class="page-shell">
		<section class="hero" aria-labelledby="page-title">
			<p class="eyebrow">LeadVenture</p>
			<h1 id="page-title">Daniel Martínez</h1>
			<p class="intro">Bienvenido a mi espacio.</p>
		</section>

		<Button>Botón de prueba</Button>

		<ButtonGroup>
			<Button variant="outline">Left</Button>
			<Button variant="outline">Middle</Button>
			<Button variant="outline">Right</Button>
		</ButtonGroup>
	</main>
</Layout>
<CodeComponent id="2" />

<style>
	:global(body) {
		margin: 0;
		background: #081426;
		color: #f8fafc;
	}

	.page-shell {
		display: grid;
		min-height: 100vh;
		place-items: center;
		padding: 2rem;
		background:
			radial-gradient(circle at 15% 20%, rgb(56 189 248 / 22%), transparent 30rem),
			radial-gradient(circle at 85% 75%, rgb(99 102 241 / 20%), transparent 28rem),
			#081426;
	}

	.hero {
		width: min(100%, 46rem);
		padding: clamp(2.5rem, 8vw, 5rem);
		border: 1px solid rgb(186 230 253 / 20%);
		border-radius: 1.5rem;
		background: rgb(15 23 42 / 70%);
		box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 25%);
		text-align: center;
		backdrop-filter: blur(12px);
	}

	.eyebrow {
		margin: 0 0 1rem;
		color: #7dd3fc;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.75rem, 9vw, 5.5rem);
		line-height: 0.95;
		letter-spacing: -0.06em;
	}

	.intro {
		margin: 1.5rem 0 0;
		color: #cbd5e1;
		font-size: clamp(1rem, 2vw, 1.25rem);
	}
</style>
