---
// An example of a page a developer writes by hand.
//
// Nothing about this page lives in the database: it is not one of the pages or
// subpages managed in /admin, it does not appear in that navigation, and it
// will not be affected if someone reorganises them. The only thing it pulls
// from the database is each component it references by number.
//
// Copy this file as a starting point for your own pages.
import Layout from '../layouts/PublicLayout.astro';
import CodeComponent from '../components/CodeComponent.astro';

// On demand, because the components it renders are read at request time.
export const prerender = false;
---

<Layout title="Example of a manual page">
	<main>
		<h1>How to build your own page</h1>
		<p class="lead">
			This page is not in the database. It is a plain <code>.astro</code> file that
			imports <code>CodeComponent</code> and references the components it needs by
			their number. The admin's <em>pages</em> and <em>subpages</em> are the main navigation;
			this is the free-form output for documenting whatever you want, however you want.
		</p>

		<pre class="snippet"><code>---
import CodeComponent from '../components/CodeComponent.astro';
---

&lt;CodeComponent id="1" /&gt;</code></pre>

		<p class="lead">
			The number is the <strong>Reference</strong> field shown by each component's
			editor. Optional props: <code>showCode={false}</code> to show only the live
			example, and <code>height="700px"</code> to adjust the frame's height.
		</p>

		<CodeComponent id="1" />
	</main>
</Layout>

<style>
	main {
		max-width: 900px;
		margin: 2rem auto;
		padding: 0 1rem;
	}
	h1 {
		font-size: 1.75rem;
		font-weight: 700;
	}
	.lead {
		color: #4b5563;
		line-height: 1.7;
	}
	code {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		background: #f3f4f6;
		border-radius: 3px;
		padding: 0.05rem 0.3rem;
		font-size: 0.875em;
	}
	.snippet {
		background: #111827;
		color: #e5e7eb;
		padding: 1rem;
		border-radius: 6px;
		overflow-x: auto;
		font-size: 0.8125rem;
	}
	.snippet code {
		background: none;
		padding: 0;
		color: inherit;
	}
</style>
