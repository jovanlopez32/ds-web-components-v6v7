---
import Layout from '../layouts/PublicLayout.astro';
import { Accordion, NavigationMenu } from '@starwind-ui/astro';
---

<Layout title="LeadVenture">
	<main class="flex min-h-screen flex-col items-center justify-center gap-8 px-6 py-10">
		<h1 class="text-3xl font-bold">Pedro Acevedo</h1>
		<h3 class="text-slate-600">Navigation menu demo</h3>
		<h3>Nuevo cambio</h3>

		<NavigationMenu.Root class="w-full max-w-4xl rounded-xl border border-slate-200 bg-white p-3 shadow-sm">
			<NavigationMenu.List class="flex flex-wrap items-center gap-2">
				<NavigationMenu.Item value="home">
					<NavigationMenu.Link href="#" class="rounded-md px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-900">
						Home
					</NavigationMenu.Link>
				</NavigationMenu.Item>

				<NavigationMenu.Item value="products">
					<NavigationMenu.Trigger class="rounded-md px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-900">
						Products ▾
					</NavigationMenu.Trigger>
					<NavigationMenu.Content class="mt-2 rounded-lg border border-slate-200 bg-white p-3 shadow-md">
						<div class="flex flex-col gap-2">
							<NavigationMenu.Link href="#" class="rounded-md px-2 py-1.5 text-sm text-slate-700 hover:bg-slate-100">Analytics</NavigationMenu.Link>
							<NavigationMenu.Link href="#" class="rounded-md px-2 py-1.5 text-sm text-slate-700 hover:bg-slate-100">Reports</NavigationMenu.Link>
							<NavigationMenu.Link href="#" class="rounded-md px-2 py-1.5 text-sm text-slate-700 hover:bg-slate-100">Dashboard</NavigationMenu.Link>
						</div>
					</NavigationMenu.Content>
				</NavigationMenu.Item>

				<NavigationMenu.Item value="resources">
					<NavigationMenu.Trigger class="rounded-md px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-900">
						Resources ▾
					</NavigationMenu.Trigger>
					<NavigationMenu.Content class="mt-2 rounded-lg border border-slate-200 bg-white p-3 shadow-md">
						<div class="flex flex-col gap-2">
							<NavigationMenu.Link href="#" class="rounded-md px-2 py-1.5 text-sm text-slate-700 hover:bg-slate-100">Docs</NavigationMenu.Link>
							<NavigationMenu.Link href="#" class="rounded-md px-2 py-1.5 text-sm text-slate-700 hover:bg-slate-100">Blog</NavigationMenu.Link>
							<NavigationMenu.Link href="#" class="rounded-md px-2 py-1.5 text-sm text-slate-700 hover:bg-slate-100">Support</NavigationMenu.Link>
						</div>
					</NavigationMenu.Content>
				</NavigationMenu.Item>

				<NavigationMenu.Item value="pricing">
					<NavigationMenu.Link href="#" class="rounded-md px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-900">
						Pricing
					</NavigationMenu.Link>
				</NavigationMenu.Item>
			</NavigationMenu.List>
		</NavigationMenu.Root>

		<div class="w-full max-w-xl">
			<h3 class="text-slate-600">Accordion demo</h3>
			
			<Accordion.Root type="single" defaultValue="item-3" class="divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
				<Accordion.Item value="item-1" class="px-4 py-3">
					<Accordion.Trigger class="flex w-full items-center justify-between text-left text-sm font-medium text-slate-800">
						What is Astro?
					</Accordion.Trigger>
					<Accordion.Panel class="pt-3 text-sm text-slate-600">
						Astro is a web framework for building fast, scalable, and secure websites.
					</Accordion.Panel>
				</Accordion.Item>

				<Accordion.Item value="item-2" class="px-4 py-3">
					<Accordion.Trigger class="flex w-full items-center justify-between text-left text-sm font-medium text-slate-800">
						Why should I use Astro?
					</Accordion.Trigger>
					<Accordion.Panel class="pt-3 text-sm text-slate-600">
						Astro gives you excellent performance and a clean content-first approach.
					</Accordion.Panel>
				</Accordion.Item>

				<Accordion.Item value="item-3" class="px-4 py-3">
					<Accordion.Trigger class="flex w-full items-center justify-between text-left text-sm font-medium text-slate-800">
						How do I get started with Astro?
					</Accordion.Trigger>
					<Accordion.Panel class="pt-3 text-sm text-slate-600">
						To get started with Astro, follow the instructions in the documentation.
					</Accordion.Panel>
				</Accordion.Item>
			</Accordion.Root>
		</div>
	</main>
</Layout>

